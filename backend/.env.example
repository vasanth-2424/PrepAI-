# Application
# Production: set APP_ENV=production and DEBUG=false
APP_NAME=PrepAI
APP_ENV=development
DEBUG=true

# Server
# On Render, PORT is injected automatically by the platform
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated allowed frontend origins, no trailing slashes)
# Production: set to your Vercel frontend URL (e.g. https://your-app.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
# Local Docker Compose: postgresql+psycopg://prepai:prepai@localhost:5432/prepai
# Production (Supabase): postgresql://... (URL-encode special characters in password)
DATABASE_URL=postgresql+psycopg://prepai:prepai@localhost:5432/prepai

# JWT
# Production: generate a strong random secret (e.g. openssl rand -base64 48)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM (Groq preferred — key must stay server-side only)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional OpenAI-compatible fallback (leave OPENAI_API_KEY empty when using Groq)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MAX_RETRIES=2

# Resume upload
MAX_UPLOAD_SIZE_MB=5
